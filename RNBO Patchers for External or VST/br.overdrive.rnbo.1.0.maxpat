            {
                "box": {
                    "autosave": 1,
                    "id": "obj-7",
                    "inletInfo": {
                        "IOInfo": [
                            {
                                "type": "signal",
                                "index": 1,
                                "tag": "in1",
                                "comment": "Left-Signal-In"
                            },
                            {
                                "type": "signal",
                                "index": 2,
                                "tag": "in2",
                                "comment": "Right-Signal-In"
                            },
                            {
                                "type": "event",
                                "index": 3,
                                "tag": "in3",
                                "comment": "Drive (Float) dB 0. to 128. How hard the signal is pushed into the curve: more Drive = more distortion. Default 18"
                            },
                            {
                                "type": "event",
                                "index": 4,
                                "tag": "in4",
                                "comment": "Tight (Float) Hz 20. to 1000. 12 dB/oct high-pass BEFORE the drive: lows push the curve hardest and turn to mud, so cutting them first keeps the distortion tight. 20 = open. Default 20"
                            },
                            {
                                "type": "event",
                                "index": 5,
                                "tag": "in5",
                                "comment": "Tone (Float) Hz 500. to 20000. 12 dB/oct low-pass AFTER the drive: tames the fizz the drive adds on top. Default 8000"
                            },
                            {
                                "type": "event",
                                "index": 6,
                                "tag": "in6",
                                "comment": "Bias (Float) % 0. to 100. Shifts the curve so the two halves of the wave clip differently: adds even harmonics, the warm tube sound. 0 = symmetric, odd harmonics only. A DC blocker removes the offset it makes. Default 20"
                            },
                            {
                                "type": "event",
                                "index": 7,
                                "tag": "in7",
                                "comment": "Auto-gain (Int) 0 off, 1 on: more Drive makes it louder, so this cuts by what the drive adds, keeping a -12 dB peak input near the same peak at any Drive. Default 1"
                            },
                            {
                                "type": "event",
                                "index": 8,
                                "tag": "in8",
                                "comment": "Level (Float) dB -24. to 12. Output level of the driven signal, before Dry/Wet: match it to the bypass sound. Default 0"
                            },
                            {
                                "type": "event",
                                "index": 9,
                                "tag": "in9",
                                "comment": "Dry/Wet (Float) % 0. to 100. Linear blend. Default 100"
                            },
                            {
                                "type": "event",
                                "index": 10,
                                "tag": "in10",
                                "comment": "On/Off (Int) 1 on, 0 off. Off fades to the dry signal at full level over 20 ms, then the DSP pauses (no CPU). Default 1"
                            }
                        ]
                    },
                    "maxclass": "newobj",
                    "numinlets": 10,
                    "numoutlets": 3,
